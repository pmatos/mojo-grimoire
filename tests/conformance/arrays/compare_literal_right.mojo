def two() -> Int:
    return 2


def main():
    var a = [1, 2]
    var x = 1
    print([1, 2] == [[1], [2]], [1] == [[1]])
    print(a == [[1], [2]], a == [[x], 2], a < [1, [3]], a != [[1], [3]])
    print(a == [[1], [two()]], a >= [[1], [3]], a > [[0], [9]])
    var b = [1]
    print(b == [[[1]]], [[1]] == [[[1]]], [[2]] >= [[[1]]])
    var n = [[1, 2], [3, 4]]
    print(n == [[[1], 2], [3, [4]]])
